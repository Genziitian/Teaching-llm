generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                       @id @default(cuid())
  name                    String
  firstName               String?
  lastName                String?
  mobileNumber            String?
  email                   String                       @unique
  role                    String                       @default("STUDENT")
  avatar                  String?
  securityNumber          String?                      @unique
  isTerminated            Boolean                      @default(false)
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  canCreateStudents       Boolean                      @default(false)
  canTerminate            Boolean                      @default(false)
  gender                  String?
  genderChangedAt         DateTime?
  age                     Int?
  state                   String?
  aboutMe                 String?
  cgpa                    Float?
  showStateOnSocialCard   Boolean                      @default(false)
  showAgeOnSocialCard     Boolean                      @default(false)
  showGenderOnSocialCard  Boolean                      @default(false)
  showIitmLevelOnSocialCard Boolean                    @default(false)
  showCgpaOnSocialCard    Boolean                      @default(false)
  instagramUrl            String?
  linkedinUrl             String?
  isProfileComplete       Boolean                      @default(false)
  iitmJoinYear            String?
  iitmJoinMonth           String?
  iitmLevel               String?
  iitmUserType            String?
  isIdentityUpdated       Boolean                      @default(false)
  blockedUntil            DateTime?
  hasSeenWelcome          Boolean                      @default(false)
  isSuperManager          Boolean                      @default(false)
  lastSeenCommunityAt     DateTime?
  lastSeenNotificationsAt DateTime?
  lastSeenSupportAt       DateTime?
  lastViolationAt         DateTime?
  tokenVersion            Int                          @default(0)
  violationCount          Int                          @default(0)
  isGoogleUser            Boolean                      @default(false)
  lastDailyDigestAt       DateTime?
  enableDetailedLogs      Boolean                      @default(false)
  appTourCompleted        Boolean                      @default(false)
  appTourCompletedAt      DateTime?
  completedTourVersion    Int                          @default(0)
  // Per-user push notification toggles. Default true so existing users keep
  // getting pushes; the Flutter app surfaces these as switches under More →
  // Push Settings. Server-side filter lives in /api/announcements and
  // src/lib/community-notifications.ts.
  notifAnnouncementsEnabled Boolean                    @default(true)
  notifCommunityEnabled   Boolean                      @default(true)
  notificationGroupEmails String?
  isNotificationGroupPending Boolean                  @default(false)
  pendingPoolCategoryIds  String?
  deletionRequestedAt     DateTime?
  deletionRequestReason   String?
  activityLogs            ActivityLog[]
  announcements           Announcement[]               @relation("AnnouncementCreator")
  createdBundleOfferings  BundleOffering[]
  chatMessages            ChatMessage[]                @relation("ChatMsgSender")
  agentSessions           ChatSession[]                @relation("ChatAgent")
  chatSessions            ChatSession[]                @relation("ChatStudent")
  createdCourses          Course[]                     @relation("CourseCreator")
  comments                Comment[]
  communityMessages       CommunityMessage[]           @relation("CommMsgSender")
  communityReadStates     CommunityReadState[]
  createdCoupons          Coupon[]                     @relation("CouponCreator")
  couponUsages            CouponUsage[]
  createdCourseBundles    CourseBundle[]               @relation("BundleCreator")
  courseEvents            CourseEvent[]                @relation("EventCreator")
  instructorCourseEvents  CourseEvent[]                @relation("EventInstructor")
  syncedSessionEvents     DailySessionSnapshot[]       @relation("SnapshotInstructor")
  enrollments             Enrollment[]
  feedbacks               Feedback[]
  appFeedbacks            AppFeedback[]
  instructorAssignments   InstructorAssignment[]
  uploadedLectures        Lecture[]                    @relation("LectureUploader")
  lectureProgress         LectureProgress[]
  loginLogs               LoginLog[]
  uploadedMaterials       Material[]                   @relation("MaterialUploader")
  mentorshipBookings      MentorshipBooking[]
  createdMentorships      MentorshipOffering[]         @relation("MentorshipCreator")
  mentorshipsAsMentor     MentorshipOffering[]         @relation("MentorAssignment")
  notifications           Notification[]
  orders                  Order[]
  promptResponses         PromptResponse[]
  pushSubscriptions       PushSubscription[]
  fcmDeviceTokens         FcmDeviceToken[]
  notificationCampaigns   NotificationCampaign[]       @relation("CampaignCreator")
  createdNotes            StoreNote[]                  @relation("NoteCreator")
  noteAccesses            StoreNoteAccess[]
  assignedTickets         SupportTicket[]              @relation("TicketAssignee")
  supportTickets          SupportTicket[]              @relation("TicketStudent")
  createdUpdates          SystemUpdate[]               @relation("UpdateCreator")
  createdTestSeries       TestSeries[]                 @relation("TestSeriesCreator")
  testSeriesAccesses      TestSeriesAccess[]
  ticketReplies           TicketReply[]                @relation("ReplyAuthor")
  updateViews             UpdateView[]
  upgradeTransactions     UpgradeTransaction[]
  courseBundleAssignments UserCourseBundleAssignment[]
  communityMutePrefs      CommunityMutePreference[]
  scheduledNotifications  ScheduledUserNotification[]
  syncedContacts          StudentContact[]
  featureRequests         FeatureRequest[]             @relation("FeatureRequestUser")
  badges                  UserBadge[]                  @relation("BadgeRecipient")
  assignedBadges          UserBadge[]                  @relation("BadgeAssigner")
  reportsMade             UserReport[]                 @relation("ReportReporter")
  reportsReceived         UserReport[]                 @relation("ReportReportedUser")
  reviewedReports         UserReport[]                 @relation("ReportReviewer")
  reportAudits            UserReportAudit[]            @relation("ReportAuditActor")
  deletionRequests        AccountDeletionRequest[]

  @@index([role])  // Used by dashboard count: prisma.user.count({ where: { role: 'STUDENT' } })
}

model Course {
  id                    String                 @id @default(cuid())
  name                  String
  description           String?
  subject               String?
  googleGroupEmail      String?
  liveGoogleGroupEmail  String?
  color                 String                 @default("#4F46E5")
  icon                  String                 @default("BookOpen")
  courseIconType        String                 @default("book_open")
  createdById           String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  expiresAt             DateTime?
  isCommunityActive     Boolean                @default(true)
  isDisabled            Boolean                @default(false)
  isDemo                Boolean                @default(false)
  isFree                Boolean                @default(false)
  isGlobal              Boolean                @default(false)
  lastMessageAt         DateTime?
  teacherName           String?
  liveUpgradePrice      Float?
  isDemoPaid            Boolean                @default(false)
  demoPrice             Float?                 @default(0)
  isDemoEnabled         Boolean                @default(false)
  demoExpiryDays        Int?                   @default(0)
  requireFeedback       Boolean                @default(false)
  aboutUs               String?
  startDate             DateTime?
  endDate               DateTime?
  announcements         Announcement[]
  bundleOfferingCourses BundleOfferingCourse[]
  createdBy             User                   @relation("CourseCreator", fields: [createdById], references: [id])
  communityMessages     CommunityMessage[]
  communityReadStates   CommunityReadState[]
  courseBundles         CourseBundleCourse[]
  courseEvents          CourseEvent[]
  courseOfferings       CourseOffering[]
  dailySessionSnapshots DailySessionSnapshot[]
  enrollments           Enrollment[]
  exams                 Exam[]
  feedbacks             Feedback[]
  groupSyncJobs         GroupSyncJob[]
  instructorAssignments InstructorAssignment[]
  lectures              Lecture[]
  materials             Material[]
  orderItems            OrderItem[]
  supportTickets        SupportTicket[]
  topics                Topic[]
  upgradeTransactions     UpgradeTransaction[]
  communityMutePrefs      CommunityMutePreference[]

  @@index([lastMessageAt])
  @@map("Class")
}

model Enrollment {
  id               String         @id @default(cuid())
  userId           String
  courseId         String         @map("classId")
  isFreeEnrollment Boolean        @default(false)
  type             EnrollmentType @default(LIVE)
  createdAt        DateTime       @default(now())
  packageName      String?
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

model CourseBundle {
  id              String                       @id @default(cuid())
  name            String
  description     String?
  createdById     String
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  createdBy       User                         @relation("BundleCreator", fields: [createdById], references: [id])
  courses         CourseBundleCourse[]
  userAssignments UserCourseBundleAssignment[]

  @@unique([createdById, name])
}

model BundleOffering {
  id                          String                 @id @default(cuid())
  name                        String
  description                 String?
  createdById                 String
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  recordedOriginalPrice       Float?
  recordedDiscountPrice       Float?
  liveOriginalPrice           Float?
  liveDiscountPrice           Float?
  allowIndividualPurchase     Boolean                @default(true)
  enableBundleDiscount        Boolean                @default(false)
  bundleDiscountType          String?
  bundleDiscountValue         Float?
  bundleDiscountApplicability String?
  requireAllCourses           Boolean                @default(true)
  forceClassType              String?
  coursePrices                String?                @default("[]")
  championOriginalPrice       Float?
  championDiscountPrice       Float?
  championSubtitle            String?
  startingPrice               Float?
  bannerText                  String?                @default("Class starts from 1 June 2026")
  startingFromText            String?                @default("Courses start from")
  courseHeadline              String?                @default("Included Courses")
  category                    String                 @default("General")
  createdBy                   User                   @relation(fields: [createdById], references: [id])
  courses                     BundleOfferingCourse[]

  @@index([createdById])
}

model BundleOfferingCourse {
  id               String         @id @default(cuid())
  bundleOfferingId String
  courseId         String         @map("classId")
  bundleOffering   BundleOffering @relation(fields: [bundleOfferingId], references: [id], onDelete: Cascade)
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([bundleOfferingId, courseId])
  @@index([bundleOfferingId])
  @@index([courseId])
}

model CourseBundleCourse {
  id       String       @id @default(cuid())
  bundleId String
  courseId String       @map("classId")
  bundle   CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  course   Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([bundleId, courseId])
  @@index([bundleId])
  @@index([courseId])
}

model UserCourseBundleAssignment {
  id           String       @id @default(cuid())
  userId       String
  bundleId     String
  assignedById String?
  createdAt    DateTime     @default(now())
  bundle       CourseBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bundleId])
  @@index([userId])
  @@index([bundleId])
}

model Lecture {
  id           String   @id @default(cuid())
  courseId     String   @map("classId")
  title        String
  description  String?
  videoUrl     String?
  notesUrl     String?
  duration     String?
  thumbnail    String?
  isDemo       Boolean  @default(false)
  uploadedById String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("LectureUploader", fields: [uploadedById], references: [id])

  @@index([courseId])
  @@index([uploadedById])
}

model Material {
  id           String   @id @default(cuid())
  courseId     String?  @map("classId")
  title        String
  description  String?
  fileUrl      String
  fileType     String
  fileSize     String?
  sourceType   String   @default("FILE")
  uploadedById String
  uploadedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isGlobal     Boolean  @default(false)
  isFree       Boolean  @default(false)
  // Taxonomy for the free-resources browser. Students filter by level + subject
  // and switch tabs (ASSIGNMENT / PYQ / NOTE / OTHER). Free-form strings on
  // level + subject so we don't need a migration for each new term — values
  // auto-populate the dropdowns from /api/free-resources/materials/options.
  category     String   @default("NOTE")
  level        String?
  subject      String?
  term         String?
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("MaterialUploader", fields: [uploadedById], references: [id])

  @@index([courseId])
  @@index([uploadedById])
  @@index([category])
  @@index([level, subject])
}

model CourseEvent {
  id                String    @id @default(cuid())
  courseId          String?   @map("classId")
  title             String
  description       String?
  startTime         DateTime
  endTime           DateTime
  meetLink          String?
  status            String    @default("SCHEDULED")
  type              String    @default("class")
  isGlobal          Boolean   @default(false)
  originalStartTime DateTime?
  recurrence        String?   @default("ONETIME")
  interval          Int?
  parentId          String?
  instructorId      String?
  createdById       String
  // Stream delivery — MEET (existing Google Meet), YOUTUBE, DRIVE, or AGORA (in-app live).
  // Defaults to MEET so every existing event keeps its current behaviour.
  streamProvider    String    @default("MEET")
  // Auto-generated channel name when streamProvider == AGORA; null otherwise.
  agoraChannelName  String?   @unique
  // Lifecycle of an AGORA stream: SCHEDULED → LIVE → ENDED.
  streamStatus      String    @default("SCHEDULED")
  startedLiveAt     DateTime?
  endedLiveAt       DateTime?
  recordingUrl      String?
  notifiedStart     Boolean   @default(false)
  notifiedAtStart   Boolean   @default(false)
  notified15mBefore Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  course            Course?   @relation(fields: [courseId], references: [id])
  createdBy         User      @relation("EventCreator", fields: [createdById], references: [id])
  instructor        User?     @relation("EventInstructor", fields: [instructorId], references: [id])

  @@index([courseId])
  @@index([startTime])
  @@index([createdById])
  @@index([type])
  @@index([isGlobal])
  @@index([streamStatus])
}

model LectureNotificationQueue {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  createdAt DateTime @default(now())

  @@index([courseId])
}

model DailySessionSnapshot {
  id            String   @id @default(cuid())
  snapshotDate  DateTime
  sourceEventId String
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  meetLink      String?
  status        String   @default("SCHEDULED")
  courseId      String?  @map("classId")
  isGlobal      Boolean  @default(false)
  instructorId  String?
  syncedAt      DateTime @default(now())
  createdById   String
  course        Course?  @relation(fields: [courseId], references: [id])
  instructor    User?    @relation("SnapshotInstructor", fields: [instructorId], references: [id])

  @@unique([snapshotDate, sourceEventId])
  @@index([snapshotDate])
  @@index([sourceEventId])
  @@index([courseId])
}

model Topic {
  id                 String               @id @default(cuid())
  courseId           String               @map("classId")
  title              String
  order              Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  content            Content[]
  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sharedContentLinks TopicSharedContent[]

  @@index([courseId])
}

model Content {
  id              String               @id @default(cuid())
  topicId         String
  title           String
  description     String?
  videoUrl        String?
  youtubeUrl      String?
  pptUrl          String?
  duration        String?
  isRecordingOnly Boolean              @default(false)
  isDemo          Boolean              @default(false)
  order           Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  videoSource     String               @default("GOOGLE_DRIVE")
  // Optional per-quality Drive file IDs for the in-app quality picker.
  // Shape: { "360p": "<driveFileId>", "720p": "<driveFileId>", ... }
  // Default playback uses `videoUrl`; the picker overlays this list when set.
  videoVariants   Json?
  comments        Comment[]
  topic           Topic                @relation(fields: [topicId], references: [id], onDelete: Cascade)
  lectureProgress LectureProgress[]
  sharedTopics    TopicSharedContent[]
}

model TopicSharedContent {
  id        String   @id @default(cuid())
  topicId   String
  contentId String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([topicId, contentId])
  @@index([topicId])
  @@index([contentId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  type        String   @default("info")
  courseId    String?  @map("classId")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  imageUrl    String?
  pollId      String?  @unique
  course      Course?  @relation(fields: [courseId], references: [id])
  createdBy   User     @relation("AnnouncementCreator", fields: [createdById], references: [id])
  poll        Poll?    @relation(fields: [pollId], references: [id])
}

model Poll {
  id                String         @id @default(cuid())
  question          String
  expiresAt         DateTime
  createdById       String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  cachedResults     String?
  lastResultsUpdate DateTime?
  announcement      Announcement?
  options           PollOption[]
  responses         PollResponse[]
}

model PollOption {
  id        String         @id @default(cuid())
  pollId    String
  text      String
  order     Int            @default(0)
  poll      Poll           @relation(fields: [pollId], references: [id], onDelete: Cascade)
  responses PollResponse[]
}

model PollResponse {
  id        String     @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime   @default(now())
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

model Exam {
  id              String         @id @default(cuid())
  externalId      String?        @unique
  title           String
  description     String?
  courseId        String?        @map("classId")
  testSeriesId    String?
  expiresAt       DateTime
  durationMinutes Int
  isPublished     Boolean        @default(false)
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  startDate       DateTime?
  examType        String         @default("FINAL_TEST")
  course          Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  testSeries      TestSeries?    @relation(fields: [testSeriesId], references: [id], onDelete: Cascade)
  attempts        ExamAttempt[]
  questions       ExamQuestion[]

  @@index([courseId])
  @@index([testSeriesId])
  @@index([externalId])
}

model ExamQuestion {
  id             String         @id @default(cuid())
  examId         String
  text           String
  type           String
  options        String?
  correctAnswer  String?
  explanation    String?
  marks          Int            @default(1)
  order          Int            @default(0)
  imageUrl       String?
  questionBankId String?
  exam           Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  responses      ExamResponse[]
}

model ExamAttempt {
  id          String         @id @default(cuid())
  examId      String
  userId      String
  startedAt   DateTime       @default(now())
  submittedAt DateTime?
  totalMarks  Float?
  bonusMarks  Float?         @default(0)
  isEvaluated Boolean        @default(false)
  feedback    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  isPublished Boolean        @default(false)
  exam        Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  responses   ExamResponse[]

  @@index([examId])
  @@index([userId])
}

model ExamResponse {
  id         String       @id @default(cuid())
  attemptId  String
  questionId String
  answer     String
  marks      Float?
  feedback   String?
  attempt    ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question   ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id           String        @id @default(cuid())
  title        String
  description  String
  type         String        @default("GENERAL")
  status       String        @default("OPEN")
  priority     String        @default("MEDIUM")
  studentId    String
  courseId     String?       @map("classId")
  assignedToId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assignedTo   User?         @relation("TicketAssignee", fields: [assignedToId], references: [id])
  course       Course?       @relation(fields: [courseId], references: [id])
  user         User          @relation("TicketStudent", fields: [studentId], references: [id])
  replies      TicketReply[]

  @@index([courseId])
  @@index([studentId])
}

model TicketReply {
  id        String        @id @default(cuid())
  ticketId  String
  senderId  String
  content   String
  imageUrl  String?
  createdAt DateTime      @default(now())
  sender    User          @relation("ReplyAuthor", fields: [senderId], references: [id])
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        String        @id @default(cuid())
  studentId String
  agentId   String?
  status    String        @default("WAITING")
  type      String        @default("SUPPORT")
  expiresAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  agent     User?         @relation("ChatAgent", fields: [agentId], references: [id])
  student   User          @relation("ChatStudent", fields: [studentId], references: [id])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformQuery {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("GENERAL")
  appliesTo String   @default("BOTH")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([order])
}


model ChatMessage {
  id              String        @id @default(cuid())
  chatId          String
  senderId        String
  content         String
  imageUrl        String?
  createdAt       DateTime      @default(now())
  deletedAt       DateTime?
  isDeleted       Boolean       @default(false)
  isSystemDeleted Boolean       @default(false)
  replyToId       String?
  chat            ChatSession   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  replyTo         ChatMessage?  @relation("ChatMessageReplies", fields: [replyToId], references: [id])
  replies         ChatMessage[] @relation("ChatMessageReplies")
  sender          User          @relation("ChatMsgSender", fields: [senderId], references: [id])
}

model CommunityMessage {
  id              String             @id @default(cuid())
  courseId        String             @map("classId")
  senderId        String
  content         String
  imageUrl        String?
  isDeleted       Boolean            @default(false)
  deletedAt       DateTime?
  createdAt       DateTime           @default(now())
  isSystemDeleted Boolean            @default(false)
  replyToId       String?
  course          Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  replyTo         CommunityMessage?  @relation("CommunityMessageReplies", fields: [replyToId], references: [id])
  replies         CommunityMessage[] @relation("CommunityMessageReplies")
  sender          User               @relation("CommMsgSender", fields: [senderId], references: [id])
  isPinned        Boolean            @default(false)
  isEdited        Boolean            @default(false)
  editedAt        DateTime?
  likes           String             @default("[]")
  reactions       String             @default("{}")

  @@index([courseId])
  @@index([senderId])
  @@index([replyToId])
}

model UserBadge {
  id           String   @id @default(cuid())
  badgeId      String
  userId       String
  assignedById String
  assignedAt   DateTime @default(now())
  note         String?
  user         User     @relation("BadgeRecipient", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy   User     @relation("BadgeAssigner", fields: [assignedById], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([assignedById])
}

model UserReport {
  id             String            @id @default(cuid())
  reportedUserId String
  reporterId     String
  reason         String
  subReason      String?
  details        String?
  status         String            @default("NEW")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  reportedUser   User              @relation("ReportReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reporter       User              @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
