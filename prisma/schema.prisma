  requestId   String
  eventType   String                 // ACCOUNT_DELETION_REQUESTED, ACCOUNT_DELETION_CANCELLED_BY_USER, ACCOUNT_DELETION_CANCELLED_BY_MANAGER, ACCOUNT_DELETION_APPROVED, ACCOUNT_DELETION_PROCESSING, ACCOUNT_DELETED
  actorType   String                 // USER, MANAGER, SYSTEM
  actorId     String?
  actorName   String?
  note        String?
  createdAt   DateTime               @default(now())

  request     AccountDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([eventType])
  @@index([createdAt])
}

model StudentContact {
  id          String   @id @default(cuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name        String?
  phoneNumber String?
  email       String?
  source      String?  @default("APP") // "FLUTTER_APP" or "CAPACITOR_APP"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, phoneNumber])
  @@index([studentId])
  @@index([phoneNumber])
  @@index([name])
  @@index([createdAt])
}

