{
  "name": "teaching-llm",
  "version": "2.6.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "(npx prisma db push --accept-data-loss || npx prisma migrate deploy || true) && npx prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "npx prisma generate && node scripts/copy-pdf-worker.js",
    "db:push:dangerous": "npx prisma db push",
    "db:migrate": "npx prisma migrate dev",
    "db:migrate:deploy": "npx prisma migrate deploy",
    "db:emergency-schema-sync": "node emergency_schema_sync.js",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:cleanup": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' src/scripts/cleanup-logs.ts",
    "analytics:compute": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' src/scripts/compute-analytics.ts",
    "db:studio": "npx prisma studio",
    "prepare": "husky install || true",
    "switch:test": "node scripts/switch-env.js test",
    "switch:prod": "node scripts/switch-env.js prod"
  },
  "engines": {
    "node": ">=18.0.0"
  },
